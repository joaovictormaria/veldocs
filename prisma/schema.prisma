// =============================================================================
// VELDOCS — Modelo de dados
// -----------------------------------------------------------------------------
// Multi-tenancy: `Company` é o tenant. Toda entidade empresarial possui
// `company_id` (equivalente ao tenant_id do MASTER SPEC).
//
// Identidade (FASE 2, DEC-009): `User` é a pessoa, global. O acesso a cada
// empresa acontece por `Membership` (uma pessoa pode estar em várias empresas).
// Perfis, responsáveis por documentos e autores de auditoria referenciam o
// vínculo `(company_id, user_id)`, garantindo que a pessoa é membro daquela
// empresa.
//
// Integridade cross-tenant no próprio banco: relações entre entidades de um
// mesmo tenant usam FKs compostas `(company_id, <fk>)`.
//
// Regras adicionais aplicadas via SQL nas migrações:
//   - audit_logs é append-only (UPDATE/DELETE bloqueados por trigger);
//   - users.email em minúsculas; CPF só como hash HMAC + valor cifrado;
//   - permissions.key no formato `recurso.acao`;
//   - sessions.id é SHA-256 hexadecimal do token (o token nunca é gravado).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  /// Removido da empresa: sem acesso; histórico e auditoria preservados.
  REMOVED
}

/// Tenant raiz. Nenhum dado empresarial existe fora de uma Company.
model Company {
  id        String        @id @default(uuid(7)) @db.Uuid
  name      String        @db.VarChar(200)
  legalName String?       @map("legal_name") @db.VarChar(200)
  /// CNPJ (somente dígitos). Sem unicidade global nesta fase — decisão pendente.
  taxId     String?       @map("tax_id") @db.VarChar(32)
  slug      String        @unique @db.VarChar(80)
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(3)

  branches           Branch[]
  departments        Department[]
  memberships        Membership[]
  roles              Role[]
  userRoles          UserRole[]
  documentCategories DocumentCategory[]
  documents          Document[]
  tags               Tag[]
  documentFiles      DocumentFile[]
  auditLogs          AuditLog[]
  modules            CompanyModule[]
  subscription       Subscription?
  invitations        CompanyInvitation[]

  @@map("companies")
}

model Branch {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(200)
  code      String?   @db.VarChar(40)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  departments Department[]
  documents   Document[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("branches")
}

model Department {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  /// Setor pode ser da empresa inteira (null) ou de uma filial.
  branchId  String?   @map("branch_id") @db.Uuid
  name      String    @db.VarChar(200)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch?    @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  documents Document[]

  @@unique([companyId, id])
  @@index([companyId, branchId])
  @@map("departments")
}

/// Pessoa (identidade global). Não pertence a uma empresa: ver Membership.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Normalizado em minúsculas (CHECK no banco). Único globalmente.
  email           String     @unique @db.VarChar(320)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  name            String     @db.VarChar(200)
  /// HMAC-SHA256 (hex) do CPF normalizado: busca e unicidade sem expor o CPF. CPF é opcional.
  cpfLookupHash   String?    @unique @map("cpf_lookup_hash") @db.VarChar(64)
  /// CPF cifrado (AES-256-GCM, formato versionado). Nunca em texto puro.
  cpfEncrypted    String?    @map("cpf_encrypted") @db.VarChar(255)
  /// Hash Argon2id. Nulo para quem entra apenas por link mágico ou Google.
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  memberships         Membership[]
  sessions            Session[]
  auditLogs           AuditLog[]
  totpCredential      UserTotpCredential?
  recoveryCodes       UserRecoveryCode[]
  acceptedInvitations CompanyInvitation[] @relation("InvitationAcceptedBy")

  @@map("users")
}

/// Segundo fator por app autenticador (TOTP). O segredo é cifrado
/// (AES-256-GCM, contexto `users.totp_secret`) e só vale após confirmação.
model UserTotpCredential {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted") @db.VarChar(255)
  /// Nulo enquanto a pessoa não confirma um código válido.
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Último passo de tempo aceito: impede reutilizar o mesmo código.
  lastUsedStep    Int?      @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_totp_credentials")
}

/// Códigos de recuperação de uso único, guardados apenas como HMAC-SHA256.
model UserRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_recovery_codes")
}

/// Vínculo de uma pessoa com uma empresa. Status e perfis são por empresa.
model Membership {
  id        String           @id @default(uuid(7)) @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company              Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles                UserRole[]
  responsibleDocuments Document[]          @relation("DocumentResponsibleMember")
  createdDocuments     Document[]          @relation("DocumentCreatedByMember")
  uploadedFiles        DocumentFile[]      @relation("DocumentFileUploader")
  actorAuditLogs       AuditLog[]          @relation("AuditLogActorMembership")
  activeSessions       Session[]
  sentInvitations      CompanyInvitation[] @relation("InvitationInviter")

  @@unique([companyId, userId])
  @@unique([companyId, id])
  @@index([userId])
  @@map("memberships")
}

/// Perfil de acesso (RBAC) sempre escopado ao tenant.
/// Perfis padrão (OWNER, ADMIN, GESTOR, COLABORADOR, VISUALIZADOR) são
/// provisionados na criação da empresa com `isSystem = true`.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  key         String   @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]
  invitations CompanyInvitation[]

  @@unique([companyId, id])
  @@unique([companyId, key])
  @@map("roles")
}

/// Catálogo GLOBAL de permissões do sistema (não é dado de tenant).
/// Formato da chave: `recurso.acao` (ex.: documents.read).
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Perfil atribuído a um membro. As FKs compostas garantem que o vínculo e o
/// perfil pertençam à MESMA empresa.
model UserRole {
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [companyId, userId], references: [companyId, userId], onDelete: Cascade)
  role       Role       @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Cascade)

  @@id([companyId, userId, roleId])
  @@index([companyId, roleId])
  @@map("user_roles")
}

model DocumentCategory {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  /// Subcategoria: referência à categoria pai do mesmo tenant.
  parentId    String?   @map("parent_id") @db.Uuid
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent    DocumentCategory?  @relation("DocumentCategoryHierarchy", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict)
  children  DocumentCategory[] @relation("DocumentCategoryHierarchy")
  documents Document[]

  @@unique([companyId, id])
  @@index([companyId, parentId])
  @@map("document_categories")
}

/// Metadados do documento. Arquivos/versões (DocumentVersion) e storage
/// privado pertencem às fases 5 (storage) e 6 (versionamento).
model Document {
  id                String    @id @default(uuid(7)) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  categoryId        String?   @map("category_id") @db.Uuid
  branchId          String?   @map("branch_id") @db.Uuid
  departmentId      String?   @map("department_id") @db.Uuid
  /// Pessoa responsável; precisa ser membro da mesma empresa.
  responsibleUserId String?   @map("responsible_user_id") @db.Uuid
  /// Pessoa que criou; precisa ser membro da mesma empresa.
  createdById       String?   @map("created_by_id") @db.Uuid
  title             String    @db.VarChar(255)
  description       String?
  issueDate         DateTime? @map("issue_date") @db.Date
  expirationDate    DateTime? @map("expiration_date") @db.Date
  /// Título, descrição e tags em minúsculas e sem acentos: a busca não depende
  /// de acentuação nem de extensão do PostgreSQL. Mantido pelo repositório.
  searchText        String    @default("") @map("search_text")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category          DocumentCategory? @relation(fields: [companyId, categoryId], references: [companyId, id], onDelete: Restrict)
  branch            Branch?           @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  department        Department?       @relation(fields: [companyId, departmentId], references: [companyId, id], onDelete: Restrict)
  responsibleMember Membership?       @relation("DocumentResponsibleMember", fields: [companyId, responsibleUserId], references: [companyId, userId], onDelete: Restrict)
  createdByMember   Membership?       @relation("DocumentCreatedByMember", fields: [companyId, createdById], references: [companyId, userId], onDelete: Restrict)
  tags              DocumentTag[]
  files             DocumentFile[]

  @@unique([companyId, id])
  @@index([companyId, expirationDate])
  @@index([companyId, categoryId])
  @@index([companyId, branchId])
  @@index([companyId, departmentId])
  @@index([companyId, responsibleUserId])
  @@index([companyId, createdById])
  @@map("documents")
}

/// Etiqueta livre da empresa (MASTER SPEC 10.1). `normalizedName` (minúsculas,
/// sem acentos) garante que "Fiscal" e "fiscal" sejam a mesma etiqueta.
model Tag {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String   @db.VarChar(40)
  normalizedName String   @map("normalized_name") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  documents DocumentTag[]

  @@unique([companyId, id])
  @@unique([companyId, normalizedName])
  @@map("tags")
}

/// Etiqueta aplicada a um documento. As FKs compostas garantem que documento e
/// etiqueta sejam da MESMA empresa.
model DocumentTag {
  companyId  String   @map("company_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Cascade)
  tag      Tag      @relation(fields: [companyId, tagId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, documentId, tagId])
  @@index([companyId, tagId])
  @@map("document_tags")
}

/// Situação do arquivo enviado (FASE 5).
enum DocumentFileStatus {
  /// URL de envio emitida; o arquivo ainda não foi conferido.
  PENDING
  /// Conferido: tamanho e assinatura batem com o declarado.
  AVAILABLE
  /// Recusado na conferência; o objeto é apagado do bucket.
  REJECTED
}

/// Arquivo de um documento. O conteúdo fica no bucket privado; aqui ficam só
/// os metadados. A chave do objeto é feita de ids internos — nunca do nome
/// original — e um CHECK garante que ela pertence à empresa da linha.
model DocumentFile {
  id              String             @id @default(uuid(7)) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  documentId      String             @map("document_id") @db.Uuid
  objectKey       String             @unique @map("object_key") @db.VarChar(255)
  /// Nome já higienizado, só para exibição e download.
  fileName        String             @map("file_name") @db.VarChar(160)
  contentType     String             @map("content_type") @db.VarChar(100)
  sizeBytes       Int                @map("size_bytes")
  status          DocumentFileStatus @default(PENDING)
  rejectionReason String?            @map("rejection_reason") @db.VarChar(200)
  uploadedById    String             @map("uploaded_by_id") @db.Uuid
  /// Depois disso a URL de envio não vale mais e o PENDING pode ser descartado.
  uploadExpiresAt DateTime           @map("upload_expires_at") @db.Timestamptz(3)
  availableAt     DateTime?          @map("available_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(3)

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  document   Document   @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  uploadedBy Membership @relation("DocumentFileUploader", fields: [companyId, uploadedById], references: [companyId, userId], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, documentId, status])
  @@map("document_files")
}

/// Trilha de auditoria append-only. `companyId` é opcional para eventos sem
/// tenant (ex.: login). Quando há empresa, o autor precisa ser membro dela.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Ex.: auth.login_succeeded, document.created
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  /// Não armazenar segredos, senhas, tokens, CPF ou conteúdo de documentos aqui.
  metadata    Json?    @db.JsonB
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  requestId   String?  @map("request_id") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company         Company?    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actorUser       User?       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership Membership? @relation("AuditLogActorMembership", fields: [companyId, actorUserId], references: [companyId, userId], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([companyId, actorUserId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Sessão autenticada. O cookie guarda um token aleatório; aqui fica apenas o
/// SHA-256 do token, então um vazamento do banco não permite sequestrar sessões.
model Session {
  /// SHA-256 (hex) do token de sessão.
  id                String    @id @db.VarChar(64)
  userId            String    @map("user_id") @db.Uuid
  /// Empresa selecionada nesta sessão; precisa ser um vínculo da pessoa.
  activeCompanyId   String?   @map("active_company_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Expiração por inatividade (renovada com o uso, limitada à absoluta).
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Expiração absoluta: a sessão nunca passa deste momento.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  /// Momento em que o segundo fator foi confirmado nesta sessão (MFA).
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(512)

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembership Membership? @relation(fields: [activeCompanyId, userId], references: [companyId, userId], onDelete: Cascade)

  @@index([userId])
  @@index([activeCompanyId, userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Janela fixa de rate limiting (substituível por Redis no futuro).
/// A chave nunca contém dado pessoal em claro (e-mail/CPF entram como HMAC).
model RateLimitBucket {
  key     String   @id @db.VarChar(200)
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

// =============================================================================
// CATÁLOGO COMERCIAL (MASTER SPEC 2.2 a 2.9)
// -----------------------------------------------------------------------------
// `modules`, `module_dependencies` e `module_prices` são GLOBAIS: descrevem o
// produto, não uma empresa. O que é por tenant são `company_modules` (módulos
// contratados) e `subscriptions` (assinatura/trial).
// =============================================================================

/// Situação do módulo no catálogo (não confundir com contratação por empresa).
enum ModuleStatus {
  /// Pode ser contratado.
  AVAILABLE
  /// Aparece no Builder, mas ainda não pode ser contratado.
  COMING_SOON
  /// Fora do catálogo; empresas que já têm continuam com ele.
  RETIRED
}

enum CompanyModuleStatus {
  ACTIVE
  INACTIVE
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

/// Estado canônico da assinatura. Os estados do trial que dependem só do tempo
/// (TRIAL_EXPIRING/TRIAL_EXPIRED) são derivados em leitura a partir de
/// `trial_ends_at` — ver src/domain/billing/subscription-status.ts.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAYMENT_PENDING
  PAST_DUE
  CANCELED
  SUSPENDED
}

model Module {
  /// Chave estável usada no código e nos entitlements (ex.: "vencimentos").
  key         String       @id @db.VarChar(60)
  name        String       @db.VarChar(120)
  description String
  /// Frase de benefício exibida no Builder.
  benefit     String       @db.VarChar(255)
  /// O Core é obrigatório e não pode ser desativado (MASTER SPEC 2.2).
  isCore      Boolean      @default(false) @map("is_core")
  status      ModuleStatus @default(AVAILABLE)
  /// Ordem de exibição no Builder.
  sortOrder   Int          @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  dependencies   ModuleDependency[] @relation("ModuleRequires")
  requiredBy     ModuleDependency[] @relation("ModuleRequiredBy")
  prices         ModulePrice[]
  companyModules CompanyModule[]
  kits           KitModule[]

  @@map("modules")
}

/// "moduleKey depende de dependsOnKey" (MASTER SPEC 2.6).
model ModuleDependency {
  moduleKey    String @map("module_key") @db.VarChar(60)
  dependsOnKey String @map("depends_on_key") @db.VarChar(60)

  module    Module @relation("ModuleRequires", fields: [moduleKey], references: [key], onDelete: Cascade)
  dependsOn Module @relation("ModuleRequiredBy", fields: [dependsOnKey], references: [key], onDelete: Restrict)

  @@id([moduleKey, dependsOnKey])
  @@index([dependsOnKey])
  @@map("module_dependencies")
}

/// Preço vigente por módulo. Histórico preservado: um preço novo fecha o
/// anterior com `valid_until` em vez de sobrescrevê-lo.
/// Módulo sem preço vigente = preço ainda não definido comercialmente.
model ModulePrice {
  id            String        @id @default(uuid(7)) @db.Uuid
  moduleKey     String        @map("module_key") @db.VarChar(60)
  /// Em centavos, para não usar ponto flutuante com dinheiro.
  amountCents   Int           @map("amount_cents")
  currency      String        @default("BRL") @db.VarChar(3)
  billingPeriod BillingPeriod @default(MONTHLY) @map("billing_period")
  validFrom     DateTime      @map("valid_from") @db.Timestamptz(3)
  validUntil    DateTime?     @map("valid_until") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  module Module @relation(fields: [moduleKey], references: [key], onDelete: Restrict)

  @@index([moduleKey, validFrom])
  @@map("module_prices")
}

/// Módulo contratado por uma empresa (entitlement).
model CompanyModule {
  companyId     String              @map("company_id") @db.Uuid
  moduleKey     String              @map("module_key") @db.VarChar(60)
  status        CompanyModuleStatus @default(ACTIVE)
  activatedAt   DateTime            @default(now()) @map("activated_at") @db.Timestamptz(3)
  deactivatedAt DateTime?           @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  module  Module  @relation(fields: [moduleKey], references: [key], onDelete: Restrict)

  @@id([companyId, moduleKey])
  @@index([companyId, status])
  @@map("company_modules")
}

/// Assinatura da empresa. Uma por empresa.
model Subscription {
  id               String             @id @default(uuid(7)) @db.Uuid
  companyId        String             @unique @map("company_id") @db.Uuid
  status           SubscriptionStatus @default(TRIALING)
  /// Kit escolhido no Builder; nulo quando a empresa contratou só módulos avulsos (DEC-024).
  kitKey           String?            @map("kit_key") @db.VarChar(60)
  /// Início e fim do trial de 14 dias (MASTER SPEC 2.8).
  trialStartedAt   DateTime?          @map("trial_started_at") @db.Timestamptz(3)
  trialEndsAt      DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  /// Fim do período pago corrente.
  currentPeriodEnd DateTime?          @map("current_period_end") @db.Timestamptz(3)
  /// Início do cancelamento: conta 1 ano de retenção dos dados (DEC-025).
  canceledAt       DateTime?          @map("canceled_at") @db.Timestamptz(3)
  /// Início da suspensão: conta 2 meses de retenção dos dados (DEC-025).
  suspendedAt      DateTime?          @map("suspended_at") @db.Timestamptz(3)
  /// Preenchido quando uma assinatura cancelada/suspensa volta a valer (2.9).
  reactivatedAt    DateTime?          @map("reactivated_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  kit Kit? @relation(fields: [kitKey], references: [key], onDelete: Restrict)

  @@index([status])
  @@index([trialEndsAt])
  @@map("subscriptions")
}

/// Kit comercial (MASTER SPEC 2.7): camada opcional sobre os módulos, que
/// pode ser combinada com módulos avulsos (DEC-024).
model Kit {
  key       String   @id @db.VarChar(60)
  name      String   @db.VarChar(120)
  /// "Indicado para".
  audience  String   @db.VarChar(255)
  /// Ordem de exibição no Builder.
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  modules       KitModule[]
  prices        KitPrice[]
  subscriptions Subscription[]

  @@map("kits")
}

/// Módulo incluído em um kit.
model KitModule {
  kitKey    String @map("kit_key") @db.VarChar(60)
  moduleKey String @map("module_key") @db.VarChar(60)

  kit    Kit    @relation(fields: [kitKey], references: [key], onDelete: Cascade)
  module Module @relation(fields: [moduleKey], references: [key], onDelete: Restrict)

  @@id([kitKey, moduleKey])
  @@index([moduleKey])
  @@map("kit_modules")
}

/// Preço de kit, com o mesmo histórico dos preços de módulo: um preço novo
/// encerra o anterior com `valid_until` em vez de sobrescrevê-lo.
model KitPrice {
  id            String        @id @default(uuid(7)) @db.Uuid
  kitKey        String        @map("kit_key") @db.VarChar(60)
  /// Em centavos.
  amountCents   Int           @map("amount_cents")
  currency      String        @default("BRL") @db.VarChar(3)
  billingPeriod BillingPeriod @default(MONTHLY) @map("billing_period")
  validFrom     DateTime      @map("valid_from") @db.Timestamptz(3)
  validUntil    DateTime?     @map("valid_until") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  kit Kit @relation(fields: [kitKey], references: [key], onDelete: Restrict)

  @@index([kitKey, validFrom])
  @@map("kit_prices")
}

/// Convite para entrar numa empresa (FASE 3). O link leva um token aleatório;
/// aqui fica só o SHA-256 dele. Vale 7 dias e uma única vez; um convite novo
/// para o mesmo e-mail revoga o anterior.
model CompanyInvitation {
  id               String    @id @default(uuid(7)) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  /// Normalizado em minúsculas (CHECK no banco).
  email            String    @db.VarChar(320)
  roleId           String    @map("role_id") @db.Uuid
  /// SHA-256 (hex) do token do link. O token nunca é gravado.
  tokenHash        String    @unique @map("token_hash") @db.VarChar(64)
  invitedByUserId  String    @map("invited_by_user_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)
  invitedBy  Membership @relation("InvitationInviter", fields: [companyId, invitedByUserId], references: [companyId, userId], onDelete: Restrict)
  acceptedBy User?      @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, email])
  @@index([expiresAt])
  @@map("company_invitations")
}
