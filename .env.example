# ============================================================================
# VELDOCS — variáveis de ambiente (EXEMPLO)
# ----------------------------------------------------------------------------
# Desenvolvimento local: copie para `.env` e ajuste se necessário.
# Staging/produção: NÃO usar arquivos .env; injetar variáveis pelo gerenciador
# de secrets da plataforma. Nunca versionar valores reais.
# ============================================================================

# Ambiente lógico da aplicação: development | staging | production
APP_ENV=development

# URL pública da aplicação (staging/production exigem https)
APP_URL=http://localhost:3000

# Nível de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- PostgreSQL local (docker compose) — credenciais apenas para uso local ---
POSTGRES_USER=veldocs
POSTGRES_PASSWORD=veldocs_dev_only
POSTGRES_DB=veldocs_dev
POSTGRES_PORT=5440

# Banco da aplicação
DATABASE_URL=postgresql://veldocs:veldocs_dev_only@127.0.0.1:5440/veldocs_dev

# Banco exclusivo dos testes de integração (é LIMPO durante os testes)
TEST_DATABASE_URL=postgresql://veldocs:veldocs_dev_only@127.0.0.1:5440/veldocs_test

# --- Chaves da aplicação (gere valores próprios por ambiente; nunca reutilize) ---
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Criptografia de dados sensíveis (ex.: CPF), AES-256-GCM: exatamente 32 bytes em base64
APP_ENCRYPTION_KEY=
# Hash de busca (HMAC-SHA256) de dados sensíveis e limites de tentativa: 32+ bytes em base64
APP_HMAC_KEY=

# --- Storage de arquivos (S3 compatível) — MinIO local do docker-compose ---
# Produção usa Railway Storage Buckets (variáveis referenciadas do bucket).
# Sem STORAGE_ENDPOINT/BUCKET/ACCESS_KEY_ID/SECRET_ACCESS_KEY o upload fica desligado.
STORAGE_ENDPOINT=http://127.0.0.1:9010
# Endereço usado pelo navegador; só muda quando o servidor roda dentro do docker-compose.
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9010
# O MinIO assina na região us-east-1; o Railway usa "auto".
STORAGE_REGION=us-east-1
STORAGE_BUCKET=veldocs-dev
STORAGE_ACCESS_KEY_ID=veldocs
STORAGE_SECRET_ACCESS_KEY=veldocs_storage_dev_only
STORAGE_FORCE_PATH_STYLE=true
# Bucket exclusivo dos testes de integração (objetos criados e apagados pelos testes)
TEST_STORAGE_BUCKET=veldocs-test
